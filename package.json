{
	"name": "transito-server",
	"version": "4.1.0",
	"description": "",
	"main": "index.js",
	"scripts": {
		"dev": "nodemon --exec tsx ./src/server.ts",
		"build": "rm -rf dist/* && tsc -p tsconfig.app.json",
		"start": "node -r module-alias/register dist/server.js",
		"docker:build": "docker compose up --build",
		"docker:start": "docker start transito-server",
		"test": "vitest run"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"nodemonConfig": {
		"ignore": [
			"**/json/**"
		]
	},
	"_moduleAliases": {
		"@fetchers": "dist/fetchers",
		"@json": "dist/json",
		"@routes": "dist/routes",
		"@app-types": "dist/types",
		"@utils": "dist/utils"
	},
	"packageManager": "pnpm@12.10.1",
	"dependencies": {
		"@koa/cors": "^5.0.0",
		"@koa/router": "^15.7.0",
		"@mapbox/polyline": "^1.2.1",
		"dotenv": "^18.0.6",
		"fast-xml-parser": "^5.11.2",
		"firebase-admin": "^14.5.0",
		"geolib": "^4.0.0",
		"koa": "^3.2.1",
		"koa-bodyparser": "^4.4.1",
		"koa-json": "^2.0.2",
		"koa-logger": "^4.0.0",
		"lodash": "^4.18.1",
		"luxon": "^3.7.2",
		"minisearch": "^7.2.0",
		"module-alias": "^2.3.4",
		"simplify-js": "^1.2.4",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/koa": "^3.0.3",
		"@types/koa-bodyparser": "^4.3.13",
		"@types/koa-json": "^2.0.24",
		"@types/koa-logger": "^3.1.5",
		"@types/koa__cors": "^5.0.1",
		"@types/lodash": "^4.17.25",
		"@types/luxon": "^3.7.6",
		"@types/mapbox__polyline": "^1.0.5",
		"@types/node": "^26.6.4",
		"nodemon": "^3.1.14",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3",
		"wrangler": "^4.148.0"
	}
}
