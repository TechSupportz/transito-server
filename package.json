{
	"name": "transito-server",
	"version": "3.0.0",
	"description": "",
	"main": "index.js",
	"scripts": {
		"dev": "nodemon -r tsconfig-paths/register ./src/server.ts",
		"build": "rm -rf dist/* && tsc -p tsconfig.app.json",
		"start": "node -r module-alias/register dist/server.js",
		"docker:build": "docker compose up --build",
		"docker:start": "docker start transito-server",
		"test": "vitest run"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"nodemonConfig": {
		"ignore": [
			"**/json/**"
		]
	},
	"_moduleAliases": {
		"@fetchers": "dist/fetchers",
		"@json": "dist/json",
		"@routes": "dist/routes",
		"@app-types": "dist/types",
		"@utils": "dist/utils"
	},
	"packageManager": "pnpm@11.5.0",
	"dependencies": {
		"@koa/cors": "^5.0.0",
		"@koa/router": "^15.4.0",
		"dotenv": "^17.4.2",
		"geolib": "^3.3.14",
		"koa": "^3.2.0",
		"koa-bodyparser": "^4.4.1",
		"koa-json": "^2.0.2",
		"koa-logger": "^4.0.0",
		"lodash": "^4.18.1",
		"luxon": "^3.7.2",
		"minisearch": "^7.2.0",
		"module-alias": "^2.3.4",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/koa": "^3.0.2",
		"@types/koa-bodyparser": "^4.3.13",
		"@types/koa-json": "^2.0.24",
		"@types/koa-logger": "^3.1.5",
		"@types/koa__cors": "^5.0.1",
		"@types/lodash": "^4.17.24",
		"@types/luxon": "^3.7.1",
		"@types/node": "^25.6.0",
		"nodemon": "^3.1.14",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.7",
		"wrangler": "^4.86.0"
	}
}
