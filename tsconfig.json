{
	"compilerOptions": {
		"target": "ESNext",
		"module": "CommonJS",
		"paths": {
			"@fetchers/*": ["./src/fetchers/*"],
			"@json": ["./src/json/index"],
			"@json/*": ["./src/json/*"],
			"@routes": ["./src/routes/index"],
			"@routes/*": ["./src/routes/*"],
			"@app-types/*": ["./src/types/*"],
			"@utils/*": ["./src/utils/*"]
		},
		"types": ["node"],
		"resolveJsonModule": true,
		"sourceMap": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"skipLibCheck": true
	},
	"files": [],
	"references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.test.json" }]
}
