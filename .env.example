# Local host port for Docker Compose. Cloudflare Tunnel can point at this.
HOST_PORT=8088

# Optional: set to "dev" to enable development-only server behavior.
ENV=

# Required for LTA-backed bus data fetching and /generate-json.
LTA_API_KEY=

# Required as the "secret" request header for POST /generate-json.
SECRET=

# Required for OneMap routes.
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# Required for NUS ETA routes.
NUS_ETA_TOKEN=

# Required for Univus/NUS static data used by /generate-json.
UNIVUS_APP_API=
UNIVUS_HTD_API=
UNIVUS_DEVICE_ID=
UNIVUS_IP_ADDRESS=
UNIVUS_VERSION=

# Optional: service account key for the route distance index upload, path inside the container.
# Put the key in ./secrets/ (mounted read-only at /app/secrets by docker-compose.beta.yml).
GOOGLE_APPLICATION_CREDENTIALS=
